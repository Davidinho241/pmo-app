# Copiez ce fichier en .env et remplacez TOUTES les valeurs d'exemple.

# Base de données (le conteneur MySQL est créé avec ces identifiants)
DB_ROOT_PASSWORD=changez-moi-root-très-long
DB_NAME=pmo
DB_USER=pmo
DB_PASSWORD=changez-moi-mot-de-passe-base

# Sécurité des sessions : chaîne aléatoire de 32 caractères minimum
#   génération : openssl rand -hex 32
SESSION_SECRET=

# Premier administrateur, créé au premier démarrage si aucun compte n'existe
ADMIN_EMAIL=prenom.nom@votre-entreprise.com
ADMIN_NAME=Administrateur
ADMIN_PASSWORD=au-moins-10-caracteres

# Réseau
#   APP_BIND=127.0.0.1 : accessible seulement depuis le serveur (à placer derrière un proxy HTTPS)
#   APP_BIND=0.0.0.0   : accessible depuis le réseau (uniquement en réseau interne de confiance)
APP_BIND=127.0.0.1
APP_PORT=3000
# Derrière un proxy HTTPS (nginx, Caddy, Traefik) : mettre les deux à true
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_HOURS=12
